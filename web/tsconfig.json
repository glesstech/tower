{
	// Typechecks the browser code in web/ (plain ES modules with JSDoc types, served as-is).
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["**/*.js"]
}
