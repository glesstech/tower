{
  "//": "Agents the swarm can start. By default it uses the agent that launched it (nearest ancestor process in detect.process, else an env var in detect.env), falling back to the first entry; --agent a,b overrides and deals tasks out round-robin. cmd is argv (no shell). files are written into each agent's working directory before it starts. Placeholders: {prompt} {name} {mcp_url} {auth}.",
  "agents": [
    {
      "name": "claude",
      "detect": { "process": ["claude"], "env": ["CLAUDECODE"] },
      "cmd": [
        "claude", "-p", "{prompt}", "--output-format", "stream-json", "--verbose",
        "--mcp-config", "mcp.json", "--strict-mcp-config",
        "--permission-mode", "acceptEdits",
        "--allowedTools", "mcp__tower__*", "Bash", "Read", "Edit", "Write"
      ],
      "files": {
        "mcp.json": { "mcpServers": { "tower": { "type": "http", "url": "{mcp_url}", "headers": { "Authorization": "{auth}" } } } }
      }
    },
    {
      "name": "opencode",
      "detect": { "process": ["opencode"], "env": ["OPENCODE"] },
      "cmd": ["opencode", "run", "-m", "opencode/gemini-3.5-flash", "{prompt}"],
      "files": {
        "opencode.json": {
          "$schema": "https://opencode.ai/config.json",
          "mcp": { "tower": { "type": "remote", "url": "{mcp_url}", "headers": { "Authorization": "{auth}" }, "enabled": true } },
          "permission": "allow"
        }
      }
    }
  ]
}
