{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top level is production: the `tower` Worker on the `tower` Artifacts namespace, for demo runs.
  "name": "tower",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The UI: web/ is served as static assets; the Worker serves its pages at /repos/:repo/<page>
  // through the ASSETS binding (see src/dashboard/pages.ts).
  "assets": { "directory": "./web", "binding": "ASSETS" },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "tower",
      // Artifacts has no local emulator; use the real service in `wrangler dev`.
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TOWER", "class_name": "Tower" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tower"] }],
  "observability": { "enabled": true },
  "env": {
    // Testing: the `tower-dev` Worker on its own `tower-dev` namespace, safe to wipe at will.
    // `npm run dev` uses this too, so local runs never touch demo repos or demo Tower state.
    "dev": {
      "name": "tower-dev",
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "tower-dev", "remote": true }],
      "durable_objects": {
        "bindings": [{ "name": "TOWER", "class_name": "Tower" }]
      }
    }
  }
}
